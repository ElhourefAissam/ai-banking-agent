generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  CONSEILLER
  SUPERVISEUR
  ADMIN
}

enum CustomerFileStatus {
  COMPLETE
  INCOMPLETE
}

enum LimitRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  COMPLEMENT_REQUESTED
  PENDING_SUPERVISOR
  APPROVED_PENDING_ACTIVATION
  ACTIVE
  ACTIVATION_FAILED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DecisionType {
  REQUEST_COMPLEMENT
  RECOMMEND_APPROVAL
  APPROVE
  REJECT
}

enum ActivationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  REQUEST_SUBMITTED
  ADVISOR_REVIEWING
  DOCUMENTS_REQUIRED
  SUPERVISOR_PENDING
  REQUEST_APPROVED
  REQUEST_REJECTED
  LIMIT_ACTIVATED
  LIMIT_RESTORED
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role             @default(CLIENT)
  portfolioId  String?
  teamId       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  customerProfile CustomerProfile?
  decisions       Decision[]
  conversations   AIConversation[]
  auditEvents     AuditEvent[]
  notifications   Notification[]

  @@index([role])
  @@index([portfolioId])
  @@index([teamId])
}

model CustomerProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  cin              String             @unique
  fileStatus       CustomerFileStatus @default(COMPLETE)
  incompleteReason String?
  address          String
  phone            String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts      Account[]
  limitRequests LimitRequest[]

  @@index([userId])
  @@index([fileStatus])
}

model Account {
  id                   String    @id @default(uuid())
  customerProfileId    String
  accountNumber        String    @unique
  iban                 String    @unique
  balance              Decimal   @default(0.00) @db.Decimal(12, 2)
  initialTransferLimit Decimal   @default(10000.00) @db.Decimal(12, 2)
  currentTransferLimit Decimal   @default(10000.00) @db.Decimal(12, 2)
  currency             String    @default("MAD")
  activeLimitExpiry    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  limitRequests   LimitRequest[]

  @@index([customerProfileId])
  @@index([accountNumber])
}

model LimitRequest {
  id                        String             @id @default(uuid())
  reference                 String             @unique
  accountId                 String
  customerProfileId         String
  initialLimit              Decimal            @db.Decimal(12, 2)
  requestedLimit            Decimal            @db.Decimal(12, 2)
  durationDays              Int
  reason                    String             @db.Text
  status                    LimitRequestStatus @default(DRAFT)
  version                   Int                @default(1)
  assignedAdvisorId         String?
  requiredDocumentsProvided Boolean            @default(false)
  activeFrom                DateTime?
  activeUntil               DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  account         Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile     @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  versions        RequestVersion[]
  documents       RequestDocument[]
  decisions       Decision[]
  activations     BankingActivation[]

  @@index([accountId])
  @@index([customerProfileId])
  @@index([status])
  @@index([assignedAdvisorId])
}

model RequestVersion {
  id            String   @id @default(uuid())
  requestId     String
  versionNumber Int
  snapshot      Json
  changeReason  String?
  createdById   String
  createdAt     DateTime @default(now())

  request LimitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, versionNumber])
}

model RequestDocument {
  id           String   @id @default(uuid())
  requestId    String
  fileName     String
  fileType     String
  fileSize     Int
  storagePath  String
  checksum     String
  uploadedById String
  createdAt    DateTime @default(now())

  request LimitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Decision {
  id            String       @id @default(uuid())
  requestId     String
  decisionType  DecisionType
  motive        String       @db.Text
  targetVersion Int
  actorId       String
  actorRole     Role
  createdAt     DateTime     @default(now())

  request LimitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([actorId])
}

model BankingActivation {
  id             String           @id @default(uuid())
  requestId      String
  idempotencyKey String           @unique
  attemptNumber  Int              @default(1)
  status         ActivationStatus @default(PENDING)
  failureReason  String?
  limitApplied   Decimal          @db.Decimal(12, 2)
  activatedAt    DateTime?
  restoredAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  request LimitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([idempotencyKey])
}

model AuditEvent {
  id            String   @id @default(uuid())
  actorId       String?
  actorEmail    String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String
  entityVersion Int?
  ipAddress     String?
  details       Json?
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  accountId String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id                   String   @id @default(uuid())
  conversationId       String
  role                 String
  content              String   @db.Text
  toolCalls            Json?
  toolResults          Json?
  confirmationMetadata Json?
  createdAt            DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
