{
  "name": "proorga-ai-banking-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Banking Workflow Platform with Multi-Tier Approvals & Controlled Agent Tools",
  "author": "PROORGA Technical Assessment",
  "license": "UNLICENSED",
  "scripts": {
    "dev:api": "pnpm --filter proorga-api dev",
    "dev:web": "pnpm --filter proorga-web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter proorga-api test:e2e",
    "demo:scenarios": "node scripts/replay-scenarios.ts",
    "lint": "pnpm -r run lint",
    "db:migrate": "pnpm --filter proorga-api prisma:migrate",
    "db:generate": "pnpm --filter proorga-api prisma:generate",
    "db:seed": "pnpm --filter proorga-api prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose exec -w /app/apps/api api ./node_modules/.bin/ts-node prisma/seed.ts",
    "docker:migrate": "docker compose exec -w /app/apps/api api ./node_modules/.bin/prisma migrate deploy",
    "docker:clean": "docker compose down -v"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  }
}
