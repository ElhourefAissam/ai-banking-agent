# ==============================================================================
# PROORGA Banking Workflow Platform — Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
API_PORT=4001
WEB_PORT=3002
WORKER_PORT=4002

# Database (PostgreSQL)
# Note: Host port 5434 is used to prevent collisions with existing local PostgreSQL instances.
POSTGRES_USER=proorga
POSTGRES_PASSWORD=proorga_secret
POSTGRES_DB=proorga_banking
POSTGRES_PORT=5434
DATABASE_URL=postgresql://proorga:proorga_secret@localhost:5434/proorga_banking?schema=public

# Redis & Background Processing
REDIS_HOST=localhost
REDIS_PORT=6380

# Security & Authentication
JWT_SECRET=proorga_banking_ultra_secure_jwt_secret_key_minimum_32_characters_for_production
JWT_EXPIRATION=24h
COOKIE_SECRET=proorga_cookie_signing_secret_random_key_32_chars

# CORS Configuration
CORS_ORIGIN=http://localhost:3002

# AI Assistant Configuration
# Supported providers: "mock" (default, zero keys required), "openai", "anthropic", "gemini"
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Banking Simulator Configuration
# SIMULATE_FAILURE: NONE | NETWORK_TIMEOUT | LOST_ACK | BANK_500
SIMULATE_FAILURE=NONE
SIMULATOR_DELAY_MS=150

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880
